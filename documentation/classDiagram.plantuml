@startuml classDiagram
abstract GameBase<T,U> {
    .. Abstract ..
    {abstract} + void GameLoop()
    {abstract} + void Init()

    .. Protected ..
    # Player<T> currentPlayer
    # std::vector<Player<T>*> players

    # BoardMap_s Map
    # PathFinding pathFinding
    # BordSize bordSize
}

class Player<T> {
    + DoTurn()
    + uint8_t ID
    + std::vector<Pawn<U>*> pawns
    + T state
}

class Pawns<U> {
    + uint8_t ID
    + Cordinates_s squareCords
    + U State
}

struct Cordinates_s {
    + uint8_t y
    + uint8_t x
}

struct BordSize {
    + Cordinates_s size
    + Cordinates_s squareSize
}

class LUDO {
    .. Public ..
    + void GameLoop()
    + void Init()
}


class StorageManager <<static>> {
    .. Public ..
    {static} + void SaveGameState()
    + LoadGameState()
}


class MotionController {
    .. Public ..
    + void SetPins()
    + void SetStepsPerMM()
    + void SetPhisicalBoardSize()
    + bool ExecutePath()
    + bool MotorToPos()
    + void SetMagnet()

    .. Private ..
    - MotorDriver* _driver
    - Coordinates_t _boardSize
    - float _phisicalBoardSizeX
    - float _phisicalBoardSizeY
    - Coordinates_t _currPos
    - float _stepsPerMM_A
    - float _stepsPerMM_B
    - float _squareSize_x
    - float _squareSize_y
}

class MotorDriver <<static>> {
    .. Public ..
    + void SetSpeeds()
    + void move()
    + void home()
}

class PathFinding <<static>> {
    .. Public ..
    + findPath()
    .. Private ..
    - floodFill()
    - floodFill_Que_add()
    - floodFill_Que_pop()
    - floodFill_scanField()
    - gatherPath()

}

BordSize -             GameBase
GameBase -             Player
Player <-              Pawns
GameBase <|--           LUDO
StorageManager --       GameBase
MotionController --     GameBase
MotorDriver --          MotionController
GameBase --             PathFinding       
@enduml